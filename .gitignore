# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Data — never push raw or processed data ───────────────────────────────────
data/raw/
data/processed/

# ── ONGC Excel files — too large, potentially sensitive ──────────────────────
*.xlsx
*.xls

# ── Results — figures and tables regenerated by notebooks ────────────────────
results/figures/
# results/tables/ IS tracked (defect N-3, IJPHM r1): the paper's Data Availability
# statement says every table is generated from the released result files, so they
# must not live only in a working tree. The "dir/* + re-include" form is required,
# because a bare "results/tables/" stops git from descending into the directory.
results/tables/*
!results/tables/*.csv
!results/tables/*.log
# MANIFEST.md maps every manuscript float to the file that backs it; the paper's
# Data Availability statement now cites it by name, so it must be tracked.
!results/tables/*.md
# Superseded arms are kept for provenance, with a README saying why each was
# retired. Same "dir/* + re-include" form: a bare directory name stops git
# descending, so negations inside it would never match.
!results/tables/superseded/
results/tables/superseded/*
!results/tables/superseded/*.csv
!results/tables/superseded/*.md

# ── Trained model weights ────────────────────────────────────────────────────
*.pt
*.pth
*.pkl
*.joblib

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.claude/
# LaTeX engine binary (downloaded locally)
tools/

# ── Paper ────────────────────────────────────────────────────────────────────
# The SUBMISSION SOURCE is tracked (defect N-3: it was untracked while the Data
# Availability statement claimed every table and figure is generated from released
# files, and an edit to it had no undo). Build products and PDFs stay ignored.
# Note the paper/* + re-include form: a bare "paper/" stops git descending, so
# negations inside it would never match.
paper/*
# Generators and verifiers are part of the reproducible pipeline: verify_tables.py
# is cited in the Data Availability statement as what makes "no number is
# hand-edited" checkable, so it cannot live only in a working tree.
!paper/*.py
!paper/files/
paper/files/*
!paper/files/*.tex
!paper/files/*.bib
!paper/files/*.cls
!paper/files/*.png
# Generated result tables \input by the manuscript (paper/make_shortened_tables.py):
# without them the tracked .tex does not compile.
!paper/files/gen/
!revision-artifacts/tools/

# React frontend
frontend/node_modules/
frontend/dist/

# ── Personal/local notes — never track, never push ───────────────────────────
*.local.md
RUN_NOTES.local.md
.aider*
