\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Generalization to University of Ferrara ($n=6$ bearings)}{11}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Aggregate vs Decimate on IMS: a Positive but Inconsistent Median Shift}{11}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Run-level aggregate$-$decimate lead-time contrast on the three multi-bearing campaigns, collapsing the five sampling factors to one difference per run. Med., Mean: run-level median and mean difference (h), with the 95\% bootstrap CI over runs; $n_+/n_-$: non-zero runs ($^{\mathrm  {s}}$: all of one sign); $p$: exact two-sided sign test. $^\ddagger $: length-30 sequence models, $n=3$ on XJTU-SY. Equivalent at $\delta =1$~h when the CI lies inside $[-\delta ,+\delta ]$: all 33 cells. Holm over $N=44$ (these 33 tests and the eleven IMS tests of Table~\ref  {tab:imsongc}): every adjusted $p$ is 1.00. IMS and ONGC are outside the equivalence family.\relax }}{12}{}\protected@file@percent }
\newlabel{tab:crossds}{{5}{12}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces IMS controlled sweep ($n=3$) and the ONGC case study ($n=1$). IMS: run differences (h) for tests 1, 2, 3, each collapsing the five within-run sampling factors to one mean aggregate$-$decimate difference, with the run-level median, $n_+/n_-$ and the exact two-sided sign-test $p$, which floors at 0.25 at $n=3$ ($^\ast $: one positive run and two ties, not counted as sign-consistent). ONGC: descriptive median over the five sampling factors, in minutes; no inference.\relax }}{12}{}\protected@file@percent }
